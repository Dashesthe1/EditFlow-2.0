{
  "manifest_version": 3,
  "name": "ChatGPT Production Watchdog",
  "version": "2.6.4",
  "description": "Observe generation events, tool activity and checkpoints; confirm prolonged silence before a verified continuation handoff.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:32146/*",
    "http://127.0.0.1:32147/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatGPT Production Watchdog",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "stream-events.js",
        "main_probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "stop-gate.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
