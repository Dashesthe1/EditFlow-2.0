{
  "manifest_version": 3,
  "name": "ChatGPT Production Watchdog",
  "version": "3.0.0",
  "description": "EditFlow browser actuator. Production health and worker ownership are decided by the local gateway supervisor.",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1:32147/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "EditFlow Production Supervisor", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
