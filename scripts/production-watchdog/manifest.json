{
  "manifest_version": 3,
  "name": "EditFlow Practice Source Supervisor",
  "version": "4.0.2",
  "description": "Delivers the first Practice chat instructions for Source Match and raw assembly only.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:32147/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "EditFlow Practice Source Supervisor"
  }
}
