{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editflow.local/schema/pro-creation-session-v1.json",
  "title": "EditFlow Pro Creation Session V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "mode", "editTypeId", "start"],
  "properties": {
    "sessionId": { "type": "string", "minLength": 1 },
    "mode": { "const": "PRO_CREATION" },
    "editTypeId": { "type": "string", "minLength": 1 },
    "start": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/startMedia" }
    }
  },
  "$defs": {
    "startMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaId", "role", "mediaKind", "uri"],
      "properties": {
        "mediaId": { "type": "string", "minLength": 1 },
        "role": { "const": "START_SOURCE" },
        "mediaKind": { "enum": ["VIDEO", "AUDIO"] },
        "uri": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string" },
        "durationMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}

