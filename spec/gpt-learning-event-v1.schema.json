{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editflow.local/schema/gpt-learning-event-v1.json",
  "title": "EditFlow GPT Learning Event V1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "tutorialTechnique": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "whenWhy", "how", "access", "proof", "transfer"],
      "properties": {
        "what": { "type": "string", "minLength": 1 },
        "whenWhy": { "type": "string", "minLength": 1 },
        "how": { "type": "string", "minLength": 1 },
        "access": { "type": "string", "minLength": 1 },
        "proof": { "type": "string", "minLength": 1 },
        "transfer": { "type": "string", "minLength": 1 }
      }
    },
    "tutorialCompilation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "compilerVersion", "targetSkillId", "tutorialId", "tutorialSkillId",
        "sourceRef", "analysisFingerprint", "constructionPattern", "capabilityIds",
        "adaptationNotes", "causalModel", "evidenceRefs"
      ],
      "properties": {
        "schema": { "const": "editflow.gpt-tutorial-causal-compilation.v1" },
        "compilerVersion": { "const": 1 },
        "targetSkillId": { "type": "string", "minLength": 1 },
        "tutorialId": { "type": "string", "minLength": 1 },
        "tutorialSkillId": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "analysisFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "constructionPattern": { "type": "string", "minLength": 1 },
        "capabilityIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "adaptationNotes": { "type": "string", "minLength": 1 },
        "causalModel": { "$ref": "#/$defs/causalModel" },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "researchSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "kind", "title"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "TUTORIAL_DRIVE", "ADOBE_DOCUMENTATION", "INSTALLED_ADOBE_FEATURE",
            "PLUGIN_DOCUMENTATION", "PROFESSIONAL_TUTORIAL", "WEB", "INTERNAL_EVIDENCE"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "tutorialTechnique": { "$ref": "#/$defs/tutorialTechnique" },
        "tutorialCompilation": { "$ref": "#/$defs/tutorialCompilation" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "TUTORIAL_DRIVE" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["uri"],
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "^https://drive\\.google\\.com/(?:file/d/|drive/folders/)"
              }
            }
          }
        },
        {
          "if": { "required": ["tutorialCompilation"] },
          "then": {
            "required": ["tutorialTechnique"],
            "properties": {
              "kind": { "const": "TUTORIAL_DRIVE" }
            }
          }
        },
        {
          "if": {
            "required": ["kind", "uri"],
            "properties": {
              "kind": { "const": "TUTORIAL_DRIVE" },
              "uri": {
                "type": "string",
                "pattern": "^https://drive\\.google\\.com/file/d/"
              }
            }
          },
          "then": {
            "required": ["tutorialTechnique", "tutorialCompilation"]
          }
        }
      ]
    },
    "capabilityGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gapId", "kind", "requestedBehavior", "missingCapabilityIds",
        "status", "evidenceRefs"
      ],
      "properties": {
        "gapId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["RECIPE_SKILL", "EXECUTION_CAPABILITY"] },
        "requestedBehavior": { "type": "string", "minLength": 1 },
        "missingCapabilityIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "status": { "enum": ["OPEN", "RESOLVED", "BLOCKED"] },
        "resolutionSkillId": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "causalModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triggerConditions", "invariants", "adaptationAxes",
        "failureSignals", "repairStrategies", "transferCriteria"
      ],
      "properties": {
        "triggerConditions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "invariants": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "adaptationAxes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "failureSignals": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "repairStrategies": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "transferCriteria": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "learnedSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId", "title", "requestedBehavior", "maturity",
        "constructionPattern", "capabilityIds", "causalModel", "researchSources",
        "evidenceRefs", "learnedAt"
      ],
      "properties": {
        "skillId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "requestedBehavior": { "type": "string", "minLength": 1 },
        "maturity": {
          "enum": ["HYPOTHESIS", "RECONSTRUCTED", "AE_PROVEN", "TRANSFER_VERIFIED"]
        },
        "constructionPattern": { "type": "string", "minLength": 1 },
        "capabilityIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "adaptationNotes": { "type": "string" },
        "causalModel": { "$ref": "#/$defs/causalModel" },
        "researchSources": {
          "type": "array",
          "items": { "$ref": "#/$defs/researchSource" }
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "learnedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "required": [
    "schema", "eventId", "sessionId", "editTypeId", "mode", "stage",
    "outcome", "summary", "evidenceRefs", "createdAt"
  ],
  "properties": {
    "schema": { "const": "editflow.gpt-learning-event.v1" },
    "eventId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "editTypeId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["PRACTICE", "PRO_CREATION"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "stage": {
      "enum": [
        "OBSERVATION", "INTERPRETATION", "HYPOTHESIS", "PLAN",
        "CAPABILITY_GAP", "RESEARCH", "CAPABILITY_IMPLEMENTATION",
        "CAPABILITY_PROOF", "SKILL_COMMIT", "AE_ACTION", "RENDER",
        "COMPARISON", "DIAGNOSIS", "CORRECTION", "RESULT", "LESSON"
      ]
    },
    "outcome": {
      "enum": ["NEUTRAL", "SUCCESS", "FAILURE", "IMPROVED", "REGRESSED"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "detail": { "type": "string" },
    "developmentPattern": { "type": "string" },
    "reusableLesson": { "type": "string" },
    "avoidRepeat": { "type": "string" },
    "capabilityGap": { "$ref": "#/$defs/capabilityGap" },
    "researchSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/researchSource" }
    },
    "learnedSkill": { "$ref": "#/$defs/learnedSkill" },
    "appliedSkillIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
