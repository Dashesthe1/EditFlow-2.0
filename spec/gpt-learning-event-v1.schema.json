{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editflow.local/schema/gpt-learning-event-v1.json",
  "title": "EditFlow GPT Learning Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "eventId", "sessionId", "editTypeId", "mode", "stage",
    "outcome", "summary", "evidenceRefs", "createdAt"
  ],
  "properties": {
    "schema": { "const": "editflow.gpt-learning-event.v1" },
    "eventId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "editTypeId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["PRACTICE", "PRO_CREATION"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "stage": {
      "enum": [
        "OBSERVATION", "INTERPRETATION", "HYPOTHESIS", "PLAN", "AE_ACTION",
        "RENDER", "COMPARISON", "DIAGNOSIS", "CORRECTION", "RESULT", "LESSON"
      ]
    },
    "outcome": {
      "enum": ["NEUTRAL", "SUCCESS", "FAILURE", "IMPROVED", "REGRESSED"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "detail": { "type": "string" },
    "developmentPattern": { "type": "string" },
    "reusableLesson": { "type": "string" },
    "avoidRepeat": { "type": "string" },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
