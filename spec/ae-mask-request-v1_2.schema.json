{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editflow.local/spec/ae-mask-request-v1_2.schema.json",
  "title": "EditFlow 2.0 AE M3 Mask Request Protocol 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "transactionId", "operationId", "capabilityId", "command", "expectedHostProjectRevision", "payload", "readbackProfile"],
  "properties": {
    "protocolVersion": {"const": "1.2.0"},
    "requestId": {"type": "string", "minLength": 1},
    "transactionId": {"type": "string", "minLength": 1},
    "operationId": {"type": "string", "minLength": 1},
    "capabilityId": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"},
    "command": {"enum": ["mask.create", "mask.remove", "mask.duplicate", "mask.reorder", "mask.set_path", "mask.set_properties", "mask.readback"]},
    "expectedHostProjectRevision": {"type": ["integer", "null"], "minimum": 0},
    "payload": {"type": "object"},
    "readbackProfile": {"type": ["string", "null"]}
  },
  "$defs": {
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "stableId": {"type": "string", "minLength": 1},
        "hostId": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "maskRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableId"],
      "properties": {"stableId": {"type": "string", "minLength": 1}}
    },
    "point2": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2
    },
    "variableFeather": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["segLocs", "relSegLocs", "radii", "interps", "tensions", "types", "relCornerAngles"],
      "properties": {
        "segLocs": {"type": "array", "items": {"type": "number"}},
        "relSegLocs": {"type": "array", "items": {"type": "number"}},
        "radii": {"type": "array", "items": {"type": "number"}},
        "interps": {"type": "array", "items": {"type": "number"}},
        "tensions": {"type": "array", "items": {"type": "number"}},
        "types": {"type": "array", "items": {"type": "number"}},
        "relCornerAngles": {"type": "array", "items": {"type": "number"}}
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed", "vertices", "inTangents", "outTangents"],
      "properties": {
        "closed": {"type": "boolean"},
        "vertices": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point2"}},
        "inTangents": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point2"}},
        "outTangents": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point2"}},
        "variableFeather": {"$ref": "#/$defs/variableFeather"}
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feather": {"$ref": "#/$defs/point2"},
        "expansion": {"type": "number"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 100},
        "mode": {"enum": ["NONE", "ADD", "SUBTRACT", "INTERSECT", "LIGHTEN", "DARKEN", "DIFFERENCE"]},
        "inverted": {"type": "boolean"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comp", "layer", "mask"],
      "properties": {
        "comp": {"$ref": "#/$defs/objectRef"},
        "layer": {"$ref": "#/$defs/objectRef"},
        "mask": {"$ref": "#/$defs/maskRef"}
      }
    }
  },
  "allOf": [{
    "oneOf": [
      {
        "properties": {
          "command": {"const": "mask.create"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["comp", "layer", "stableId"],
            "properties": {
              "comp": {"$ref": "#/$defs/objectRef"},
              "layer": {"$ref": "#/$defs/objectRef"},
              "stableId": {"type": "string", "minLength": 1},
              "name": {"type": "string"},
              "shape": {"$ref": "#/$defs/shape"},
              "properties": {"$ref": "#/$defs/properties"}
            }
          }
        }
      },
      {
        "properties": {
          "command": {"enum": ["mask.remove", "mask.readback"]},
          "payload": {"$ref": "#/$defs/target"}
        }
      },
      {
        "properties": {
          "command": {"const": "mask.duplicate"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["comp", "layer", "mask", "stableId"],
            "properties": {
              "comp": {"$ref": "#/$defs/objectRef"},
              "layer": {"$ref": "#/$defs/objectRef"},
              "mask": {"$ref": "#/$defs/maskRef"},
              "stableId": {"type": "string", "minLength": 1},
              "name": {"type": "string"}
            }
          }
        }
      },
      {
        "properties": {
          "command": {"const": "mask.reorder"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["comp", "layer", "mask", "index"],
            "properties": {
              "comp": {"$ref": "#/$defs/objectRef"},
              "layer": {"$ref": "#/$defs/objectRef"},
              "mask": {"$ref": "#/$defs/maskRef"},
              "index": {"type": "integer", "minimum": 1}
            }
          }
        }
      },
      {
        "properties": {
          "command": {"const": "mask.set_properties"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["comp", "layer", "mask", "properties"],
            "properties": {
              "comp": {"$ref": "#/$defs/objectRef"},
              "layer": {"$ref": "#/$defs/objectRef"},
              "mask": {"$ref": "#/$defs/maskRef"},
              "properties": {"$ref": "#/$defs/properties"}
            }
          }
        }
      },
      {
        "properties": {
          "command": {"const": "mask.set_path"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["comp", "layer", "mask"],
            "properties": {
              "comp": {"$ref": "#/$defs/objectRef"},
              "layer": {"$ref": "#/$defs/objectRef"},
              "mask": {"$ref": "#/$defs/maskRef"},
              "shape": {"$ref": "#/$defs/shape"},
              "keyframes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["time", "shape"],
                  "properties": {
                    "time": {"type": "number"},
                    "shape": {"$ref": "#/$defs/shape"}
                  }
                }
              }
            },
            "oneOf": [
              {"required": ["shape"], "not": {"required": ["keyframes"]}},
              {"required": ["keyframes"], "not": {"required": ["shape"]}}
            ]
          }
        }
      }
    ]
  }]
}
