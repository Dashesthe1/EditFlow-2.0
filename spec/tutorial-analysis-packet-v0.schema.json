{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editflow.local/spec/tutorial-analysis-packet-v0.schema.json",
  "title": "EditFlow Tutorial Analysis Packet V0",
  "type": "object",
  "additionalProperties": false,
  "required": ["tutorialId", "title", "sourceRef", "durationMs", "evidenceRefs", "skills"],
  "properties": {
    "tutorialId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "sourceRef": {"type": "string", "minLength": 1},
    "durationMs": {"type": "number", "exclusiveMinimum": 0},
    "evidenceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "skills": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/skill"}}
  },
  "$defs": {
    "proofMaturity": {
      "enum": ["DECLARED", "STRUCTURAL", "VISUAL", "ROLLBACK", "TRANSFER", "ROBUST"]
    },
    "routeKind": {
      "enum": ["NATIVE_TYPED", "HOST_ADAPTER", "SUBSYSTEM_ADAPTER", "PLUGIN_ADAPTER", "GUARDED_UI"]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "reason", "minimumProofMaturity"],
      "properties": {
        "capabilityId": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "minimumProofMaturity": {"$ref": "#/$defs/proofMaturity"},
        "optional": {"type": "boolean"},
        "preferredRouteKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/routeKind"}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "startMs", "endMs", "intent", "action", "observableResult", "capabilityRequirements"],
      "properties": {
        "stepId": {"type": "string", "minLength": 1},
        "startMs": {"type": "number", "minimum": 0},
        "endMs": {"type": "number", "exclusiveMinimum": 0},
        "intent": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "observableResult": {"type": "string", "minLength": 1},
        "capabilityRequirements": {
          "type": "array",
          "items": {"$ref": "#/$defs/requirement"}
        },
        "evidenceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "name", "objective", "whenToUse", "adaptationVariables", "validationCriteria", "steps"],
      "properties": {
        "skillId": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "whenToUse": {"type": "string", "minLength": 1},
        "adaptationVariables": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "validationCriteria": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        }
      }
    }
  }
}
