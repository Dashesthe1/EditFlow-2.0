{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editflow.local/schema/practice-truth-population-plan-v1.json",
  "title": "EditFlow Practice Truth Population Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "editTypeId", "cases"],
  "properties": {
    "schema": { "const": "editflow.practice-truth-population-plan.v1" },
    "editTypeId": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "difficulty": {
      "enum": [
        "FAST_CUTS", "NEAR_DUPLICATE_SOURCES", "REVERSE_OR_REWIND",
        "LOW_INFORMATION", "STRONG_CAMERA_MOTION", "OCCLUSION",
        "IDENTITY_AMBIGUITY", "HEAVY_EFFECT_OBSCURATION", "REPEATED_SCENERY"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "path"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "difficultyTags", "finishPath", "sourceMedia"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "difficultyTags": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/difficulty" }
        },
        "finishPath": { "type": "string", "minLength": 1 },
        "sourceMedia": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "referenceAnalysis": { "type": "string", "minLength": 1 },
        "truthDraft": { "type": "string", "minLength": 1 },
        "reviewPackDir": { "type": "string", "minLength": 1 },
        "retainedTruth": { "type": "string", "minLength": 1 },
        "matches": { "type": "string", "minLength": 1 },
        "suiteManifest": { "type": "string", "minLength": 1 }
      }
    }
  }
}
