{
  "name": "editflow-2.0",
  "version": "0.6.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile .tmp/typecheck.tsbuildinfo",
    "build:test-runtime": "tsc -p tsconfig.runtime.json --incremental --tsBuildInfoFile .tmp/runtime.tsbuildinfo",
    "test": "npm run build:test-runtime && node --test tests/*.test.mjs",
    "check": "npm run validate:schemas && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "ajv": "^8.17.1",
    "typescript": "^5.9.2"
  }
}
