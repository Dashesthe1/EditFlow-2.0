{
  "name": "editflow-2.0",
  "version": "0.6.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile .tmp/typecheck.tsbuildinfo",
    "build:test-runtime": "tsc -p tsconfig.runtime.json --incremental --tsBuildInfoFile .tmp/runtime.tsbuildinfo",
    "practice:panel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/run-practice-panel.ps1",
    "practice:truth-suite": "npm run build:test-runtime && node .tmp/runtime/apps/desktop-host/src/practice-retained-truth-suite-cli.js",
    "practice:truth-correction-replay": "npm run build:test-runtime && node .tmp/runtime/apps/desktop-host/src/practice-retained-truth-correction-cli.js",
    "practice:truth-correction-profile": "npm run build:test-runtime && node .tmp/runtime/apps/desktop-host/src/practice-retained-truth-correction-profile-cli.js",
    "practice:recertify": "npm run build:test-runtime && node .tmp/runtime/apps/desktop-host/src/practice-robust-recertification-cli.js",
    "test": "npm run build:test-runtime && node --test tests/*.test.mjs",
    "check": "npm run validate:schemas && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "ajv": "^8.17.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2"
  }
}
